# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=

# Anthropic API （统一openai兼容模式，暂不使用）
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_DEFAULT_MODEL=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=渡一LangChain学习

# TAVILY
TAVILY_API_KEY=

# langfuse
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""
# 定期清理 Trace 的保留天数；不配置时清理函数拒绝执行
LANGFUSE_TRACE_RETENTION_DAYS=1
# 实验 Webhook 独立签名密钥；留空时拒绝请求（503）
LANGFUSE_EXPERIMENT_WEBHOOK_SECRET=""
# Alert Automation 的独立 Webhook 签名密钥；留空时拒绝请求（503）
LANGFUSE_ALERT_WEBHOOK_SECRET=""

# benchmark
BENCHMARK_AGENT_SERVER="http://localhost/"
BENCHMARK_USER_ID="test_user"
BENCHMARK_GRAPH_ID="main_agent"


# 以下配置仅用于基础设施启动的环境变量

# ------langfuse-----

LANGFUSE_WEBHOOK_WHITELISTED_HOST=host.docker.internal

# [可选]Langfuse 事务邮件（不要在示例文件中填写真实邮箱或 SMTP 安全密码）
LANGFUSE_SMTP_CONNECTION_URL=
LANGFUSE_EMAIL_FROM_ADDRESS=

# [可选]Langfuse Ask AI（复用文件上方的 OpenAI 兼容模型配置）
LANGFUSE_OPENAI_API_KEY=${OPENAI_API_KEY}
LANGFUSE_OPENAI_BASE_URL=${OPENAI_BASE_URL}
LANGFUSE_OPENAI_DEFAULT_MODEL=${OPENAI_DEFAULT_MODEL}

# Langfuse 自托管密钥：首次部署前用 `openssl rand -base64 32` 生成后填入，切勿提交真实值
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# Langfuse 依赖组件（postgres / clickhouse / minio）的账号密码，由 docker compose 注入
LANGFUSE_POSTGRES_USER=root
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=postgres
LANGFUSE_CLICKHOUSE_USER=root
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=root
LANGFUSE_MINIO_ROOT_PASSWORD=

# ------litellm-----

# LiteLLM Master Key：客户端调用时使用的密钥，需以 sk- 开头；
# Salt Key：用于加密写入数据库的上游模型凭据，写入后不可更改
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# LiteLLM 管理后台登录账号
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# LiteLLM 依赖组件（postgres）的账号密码，由 docker compose 注入
LITELLM_POSTGRES_USER=root
LITELLM_POSTGRES_PASSWORD=
LITELLM_POSTGRES_DB=postgres

# ------nacos------

# Nacos 各节点必须一致，用于服务端 token 加密与身份校验
# NACOS_AUTH_TOKEN 需为 Base64 编码且原始字符串不少于 32 位
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# Nacos
# API服务地址
NACOS_SERVER_ADDRESS = "http://localhost:8848/"
# 命名空间
NACOS_NAMESPACE_ID = "public"
# 用户名
NACOS_USERNAME = "deal_pilot"
# 用户密码
NACOS_PASSWORD = "123456"